#!/bin/bash
#PBS -N probe
#PBS -l walltime=01:00:00
#PBS -l select=1:ncpus=2:mem=8gb:scratch_local=20gb:ngpus=1:cluster=bee
#PBS -j oe

set +e

OUT="$HOME/h100_probe2_${PBS_JOBID}"
mkdir -p "$OUT"
LOG="$OUT/report.txt"
exec > >(tee -a "$LOG") 2>&1

IMAGE="/cvmfs/singularity.metacentrum.cz/NGC/PyTorch:26.06-py3.SIF"

echo "=== BASIC INFO ==="
date
hostname
echo "HOME=$HOME"
echo "SCRATCHDIR=$SCRATCHDIR"
echo "CUDA_VISIBLE_DEVICES=$CUDA_VISIBLE_DEVICES"

echo
echo "=== GPU ==="
nvidia-smi
nvidia-smi --query-gpu=name,driver_version,memory.total,compute_cap --format=csv

echo
echo "=== IMAGE ==="
ls -lh "$IMAGE"
singularity --version

echo
echo "=== CONTAINER START TEST ==="
date
time singularity exec --nv "$IMAGE" python -c \
'import sys; print(sys.version); print("container started")'
date

echo
echo "=== PYTORCH TEST ==="

time singularity exec --nv "$IMAGE" python - <<'PY'
import torch

print("torch:", torch.__version__)
print("torch CUDA:", torch.version.cuda)
print("cuDNN:", torch.backends.cudnn.version())
print("CUDA available:", torch.cuda.is_available())
print("GPU count:", torch.cuda.device_count())

if torch.cuda.is_available():
    print("GPU:", torch.cuda.get_device_name(0))
    p = torch.cuda.get_device_properties(0)
    print("compute capability:", p.major, p.minor)
    print("VRAM GiB:", p.total_memory / 1024**3)

    print("Running matrix multiplication...")
    x = torch.randn((4096,4096), device="cuda")
    y = x @ x
    torch.cuda.synchronize()
    print("CUDA computation OK:", y.shape)
PY

echo
echo "=== INTERNET FROM HOST ==="

for HOST in pypi.org github.com huggingface.co; do
    echo "--- $HOST ---"
    getent hosts "$HOST" | head
done

for URL in \
    https://pypi.org \
    https://github.com \
    https://huggingface.co
do
    echo "--- $URL ---"
    curl -L -sS \
         --connect-timeout 10 \
         --max-time 20 \
         -o /dev/null \
         -w 'HTTP=%{http_code} remote=%{remote_ip} time=%{time_total}\n' \
         "$URL"
done

echo
echo "=== INTERNET FROM CONTAINER ==="

singularity exec --nv "$IMAGE" python - <<'PY'
import socket
import urllib.request

hosts = ["pypi.org", "github.com", "huggingface.co"]

for h in hosts:
    try:
        print("DNS", h, socket.gethostbyname(h))
    except Exception as e:
        print("DNS FAIL", h, repr(e))

for u in [
    "https://pypi.org",
    "https://github.com",
    "https://huggingface.co",
]:
    try:
        with urllib.request.urlopen(u, timeout=20) as r:
            print("HTTP", u, r.status)
    except Exception as e:
        print("HTTP FAIL", u, repr(e))
PY

echo
echo "=== HOME FROM CONTAINER ==="

echo "test-$PBS_JOBID" > "$OUT/home_test.txt"

singularity exec "$IMAGE" \
    bash -c "cat '$OUT/home_test.txt' && echo 'HOME bind OK'"

echo
echo "=== PACKAGE INSTALLATION POSSIBILITIES ==="

singularity exec "$IMAGE" python - <<'PY'
import sys, site
print("Python:", sys.executable)
print("prefix:", sys.prefix)
print("user site:", site.getusersitepackages())
PY

echo
echo "=== FINISHED ==="
date
echo "Report: $LOG"

clean_scratch 2>/dev/null || true
